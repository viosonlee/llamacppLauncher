<Window x:Class="LlamaManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Llama.cpp Manager"
        Width="720" Height="820"
        MinWidth="620" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Status Bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="{StaticResource ErrorBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="已停止" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="LiveSpeedText" Grid.Row="1" Grid.ColumnSpan="2" Text=""
                           FontSize="14" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"
                           Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="CudaText" Text="CUDA: 检测中..." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                    <TextBlock x:Name="PortText" Text=":8080" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tabs -->
        <TabControl x:Name="ConfigurationTabs" Grid.Row="1" Margin="0,0,0,6" Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource AccentBrush}">
            <!-- Model Selection Tab -->
            <TabItem Header="模型选择">
                <Grid Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Models Directory Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="模型目录:" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
                        <TextBox x:Name="ModelsDirTextBox" Grid.Column="1" FontSize="11"
                                 VerticalContentAlignment="Center" KeyDown="ModelsDirTextBox_KeyDown"
                                 LostFocus="ModelsDirTextBox_LostFocus"
                                 ToolTip="指定模型文件夹，将自动递归扫描其所有子目录下的 .gguf 文件"/>
                        <Button Grid.Column="2" Content="选择文件夹..." Click="ModelsDirButton_Click"
                                Margin="6,0,0,0" Padding="8,4" FontSize="11"/>
                        <Button Grid.Column="3" Content="刷新" Click="RefreshModelsButton_Click"
                                Margin="4,0,0,0" Padding="8,4" FontSize="11" ToolTip="重新扫描模型并刷新所选引擎的设备检测"/>
                        <Button Grid.Column="4" Content="单文件..." Click="BrowseButton_Click"
                                Margin="4,0,0,0" Padding="8,4" FontSize="11" ToolTip="选择任意单独的 GGUF 文件"/>
                    </Grid>

                    <ListBox x:Name="ModelListBox" Grid.Row="1"
                             Height="120" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ModelListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding FullName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding SizeFormatted}" Width="70"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" CornerRadius="3" Padding="4,1" Margin="0,0,6,0"
                                            BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1"
                                            ToolTip="{Binding Category}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ModelTypeDisplay}" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="SelectedModelText"
                                   Text="未选择模型" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" x:Name="ModelCountText"
                                   Text="共 0 个模型" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="8,0,0,0"/>
                    </Grid>
                    
                    <TextBlock Grid.Row="3" x:Name="ModelInfoText"
                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,2,0,0" TextWrapping="Wrap" MaxHeight="65" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </Grid>
            </TabItem>

            <!-- Common Parameters Tab -->
            <TabItem Header="常用参数">
                <Grid Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Context Length -->
                    <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="上下文长度 (-c)" FontSize="12" VerticalAlignment="Center"/>
                        <TextBox x:Name="ContextLengthBox" Grid.Column="1" Text="8192" FontSize="12"
                                 VerticalContentAlignment="Center" TextChanged="ContextLength_TextChanged"/>
                        <Button Grid.Column="2" Content="?" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="context_length"/>
                    </Grid>

                    <!-- K Quantization -->
                    <Grid Grid.Row="0" Grid.Column="1" Margin="6,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="K 量化 (-ctk)" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ContextQuantKBox" Grid.Column="1" FontSize="12" Height="26"
                                  SelectedIndex="0" SelectionChanged="ContextQuant_SelectionChanged">
                            <ComboBoxItem Content="默认 (未量化/f16)"/>
                            <ComboBoxItem Content="q8_0 (8-bit)"/>
                            <ComboBoxItem Content="q4_0 (4-bit)"/>
                            <ComboBoxItem Content="q4_1 (4-bit)"/>
                            <ComboBoxItem Content="f16"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="?" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="context_quant"/>
                    </Grid>

                    <!-- Offload Layers -->
                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="卸载层数 (-ngl)" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox x:Name="OffloadLayersBox" Grid.Column="1" FontSize="12" Height="26"
                                  IsEditable="True" Text="all" SelectionChanged="OffloadLayers_SelectionChanged"
                                  LostFocus="OffloadLayers_LostFocus">
                            <ComboBoxItem Content="all"/>
                            <ComboBoxItem Content="auto"/>
                            <ComboBoxItem Content="0"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="?" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="offload_layers"/>
                    </Grid>

                    <!-- V Quantization -->
                    <Grid Grid.Row="1" Grid.Column="1" Margin="6,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="V 量化 (-ctv)" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ContextQuantVBox" Grid.Column="1" FontSize="12" Height="26"
                                  SelectedIndex="0" SelectionChanged="ContextQuant_SelectionChanged">
                            <ComboBoxItem Content="默认 (未量化/f16)"/>
                            <ComboBoxItem Content="q8_0 (8-bit)"/>
                            <ComboBoxItem Content="q4_0 (4-bit)"/>
                            <ComboBoxItem Content="q4_1 (4-bit)"/>
                            <ComboBoxItem Content="f16"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="?" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="context_quant_v"/>
                    </Grid>

                    <!-- CPU Cores -->
                    <Grid Grid.Row="2" Grid.Column="1" Margin="6,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CPU 核心数 (-t)" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CpuCoresBox" Grid.Column="1" FontSize="12" Height="26"
                                  SelectionChanged="CpuCores_SelectionChanged"/>
                        <Button Grid.Column="2" Content="?" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="cpu_cores"/>
                    </Grid>

                    <!-- Reasoning -->
                    <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="思考模式" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ReasoningBox" Grid.Column="1" FontSize="12" Height="26"
                                  SelectedIndex="0" SelectionChanged="Reasoning_SelectionChanged">
                            <ComboBoxItem Content="默认"/>
                            <ComboBoxItem Content="off (关闭)"/>
                            <ComboBoxItem Content="on (开启)"/>
                            <ComboBoxItem Content="auto"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="?" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="reasoning"/>
                    </Grid>

                    <!-- Flash Attention -->
                    <Grid Grid.Row="4" Grid.Column="1" Margin="6,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Flash Attention" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox x:Name="FlashAttentionBox" Grid.Column="1" FontSize="12" Height="26"
                                  SelectedIndex="0" SelectionChanged="FlashAttention_SelectionChanged">
                            <ComboBoxItem Content="默认"/>
                            <ComboBoxItem Content="off (关闭)"/>
                            <ComboBoxItem Content="on (开启)"/>
                            <ComboBoxItem Content="auto"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="?" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="flash_attention"/>
                    </Grid>

                    <!-- Batch Size -->
                    <Grid Grid.Row="3" Grid.Column="0" Margin="0,0,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="批处理大小 (-b)" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox x:Name="BatchSizeBox" Grid.Column="1" FontSize="12" Height="26"
                                  IsEditable="True" Text="2048" SelectionChanged="BatchSize_SelectionChanged"
                                  LostFocus="BatchSize_LostFocus">
                            <ComboBoxItem Content="2048"/>
                            <ComboBoxItem Content="1024"/>
                            <ComboBoxItem Content="512"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="?" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click" Tag="batch_size"/>
                    </Grid>

                    <!-- UBatch Size -->
                    <Grid Grid.Row="3" Grid.Column="1" Margin="6,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="物理批大小 (-ub)" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox x:Name="UBatchSizeBox" Grid.Column="1" FontSize="12" Height="26"
                                  IsEditable="True" Text="512" SelectionChanged="UBatchSize_SelectionChanged"
                                  LostFocus="UBatchSize_LostFocus">
                            <ComboBoxItem Content="512"/>
                            <ComboBoxItem Content="256"/>
                            <ComboBoxItem Content="128"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="?" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click" Tag="ubatch_size"/>
                    </Grid>

                    <!-- Verbose Logging -->
                    <Grid Grid.Row="4" Grid.Column="0" Margin="0,0,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="详细调用日志" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox x:Name="VerboseLogBox" Grid.Column="1" FontSize="12" Height="26"
                                  SelectedIndex="0" SelectionChanged="VerboseLog_SelectionChanged">
                            <ComboBoxItem Content="关闭 (默认)"/>
                            <ComboBoxItem Content="开启 (-v / 详细)"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="?" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="verbose_log"/>
                    </Grid>

                    <!-- Speculative Decoding Type -->
                    <Grid Grid.Row="5" Grid.Column="0" Margin="0,0,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="投机解码" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SpecTypeBox" Grid.Column="1" FontSize="12" Height="26"
                                  SelectedIndex="0" SelectionChanged="SpecType_SelectionChanged">
                            <ComboBoxItem Content="默认 (不传)"/>
                            <ComboBoxItem Content="draft-mtp"/>
                            <ComboBoxItem Content="draft-simple"/>
                            <ComboBoxItem Content="draft-eagle3"/>
                            <ComboBoxItem Content="ngram-mod"/>
                            <ComboBoxItem Content="none"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="?" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="spec_type"/>
                    </Grid>

                    <!-- Reasoning Budget -->
                    <Grid Grid.Row="5" Grid.Column="1" Margin="6,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="思考上限 (tokens)" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ReasoningBudgetBox" Grid.Column="1" FontSize="12" Height="26"
                                  IsEditable="True" Text="默认" SelectionChanged="ReasoningBudget_SelectionChanged"
                                  LostFocus="ReasoningBudget_LostFocus">
                            <ComboBoxItem Content="默认"/>
                            <ComboBoxItem Content="-1 (无限制)"/>
                            <ComboBoxItem Content="0 (零预算)"/>
                            <ComboBoxItem Content="1024"/>
                            <ComboBoxItem Content="2048"/>
                            <ComboBoxItem Content="4096"/>
                            <ComboBoxItem Content="8192"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="?" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="reasoning_budget"/>
                    </Grid>

                    <!-- Speculative Draft Model -->
                    <Grid Grid.Row="6" Grid.ColumnSpan="2" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="草稿模型 (-md)" FontSize="12" VerticalAlignment="Center"/>
                        <TextBox x:Name="DraftModelBox" Grid.Column="1" FontSize="12" Height="26"
                                 VerticalContentAlignment="Center"
                                 ToolTip="投机解码草稿模型路径；与上方投机解码选项配合使用"
                                 TextChanged="DraftModel_TextChanged" LostFocus="DraftModel_LostFocus"/>
                        <Button Grid.Column="2" Content="浏览..." FontSize="11" Height="26"
                                Padding="8,0" Margin="6,0,0,0" Click="DraftModelBrowse_Click"/>
                        <Button Grid.Column="3" Content="?" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="draft_model"/>
                    </Grid>

                    <!-- Built-in MTP (auto-detected from GGUF metadata) -->
                    <Border x:Name="MtpSection" Grid.Row="8" Grid.ColumnSpan="2" BorderThickness="1,0,0,0"
                            BorderBrush="{StaticResource TextSecondaryBrush}" Padding="8,6,0,4" Margin="0,4,0,0"
                            Visibility="Collapsed"
                            ToolTip="该模型的 GGUF 内置 MTP（多 Token 预测）头；开启后使用 draft-mtp 投机解码，无需单独草稿文件">
                        <CheckBox x:Name="MtpCheckbox" Content="启用内置 MTP 投机解码 (--spec-type draft-mtp)"
                                  FontSize="11" VerticalAlignment="Center"
                                  Checked="MtpCheckbox_Changed" Unchecked="MtpCheckbox_Changed"/>
                    </Border>

                    <!-- MoE Section (auto-hide for dense models) -->
                    <Border x:Name="MoeSection" Grid.Row="7" Grid.ColumnSpan="2" BorderThickness="1,0,0,0"
                            BorderBrush="{StaticResource TextSecondaryBrush}" Padding="8,6,0,4" Margin="0,4,0,0"
                            ToolTip="以下设置仅对MoE（混合专家）模型生效">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- MoE CPU Offload -->
                            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,6,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="MoE卸载 (--n-cpu-moe)" FontSize="11" VerticalAlignment="Center"/>
                                <ComboBox x:Name="MoeOffloadBox" Grid.Column="1" FontSize="12" Height="26"
                                          IsEditable="True" Text="默认" SelectionChanged="MoeOffload_SelectionChanged"
                                          LostFocus="MoeOffload_LostFocus">
                            <ComboBoxItem Content="默认"/>
                            <ComboBoxItem Content="0 (不强制)"/>
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="8"/>
                            <ComboBoxItem Content="16"/>
                            <ComboBoxItem Content="32"/>
                        </ComboBox>
                                <Button Grid.Column="2" Content="?" FontSize="11" Width="24" Height="22"
                                        Padding="0" Margin="4,0,0,0" Click="InfoButton_Click" Tag="n_cpu_moe"/>
                            </Grid>

                            <!-- CPU MoE Toggle -->
                            <Grid Grid.Row="0" Grid.Column="1" Margin="6,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="CpuMoeCheckbox" Grid.Column="0" Content="CPU MoE (--cpu-moe)"
                                          FontSize="11" VerticalAlignment="Center"
                                          ToolTip="强制MoE混合专家模型在CPU上计算专家层（而非GPU）"
                                          Checked="CpuMoeCheckbox_Changed" Unchecked="CpuMoeCheckbox_Changed"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Advanced Options Tab -->
            <TabItem Header="高级选项">
                <Grid Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="自定义启动参数 (llama-server 命令行):" Margin="0,0,0,6" FontSize="12"/>

                    <TextBox x:Name="ArgsTextBox" Grid.Row="1"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Height="100"
                             FontFamily="Consolas" FontSize="11"
                             VerticalContentAlignment="Top"
                             TextChanged="ArgsTextBox_TextChanged"/>

                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="重新生成预设参数" Click="RegenerateButton_Click"
                                HorizontalAlignment="Left" Padding="12,5" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="端口:" Margin="8,0,6,0" FontSize="12" VerticalAlignment="Center"/>
                        <TextBox x:Name="PortTextBox" Grid.Column="2" Width="60" FontSize="12"
                                 VerticalContentAlignment="Center" Text="8080" LostFocus="PortTextBox_LostFocus"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Strata Tab -->
            <TabItem Header="Strata">
                <Grid Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Cyber on Strata 专家流式推理（35B MoE · 独立引擎 · 与 llama-server 共享显存不可同开）"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"
                               ToolTip="运行 Strata 前会请求停止 llama-server；运行结束后可再启动 llama-server。"/>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="包目录:" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
                        <TextBox x:Name="StrataRootTextBox" Grid.Column="1" FontSize="11"
                                 VerticalContentAlignment="Center"
                                 ToolTip="包含 engine\strata.exe 的 Cyber on Strata 包目录"/>
                        <Button Grid.Column="2" Content="浏览..." Click="StrataRootButton_Click"
                                Margin="6,0,0,0" Padding="8,4" FontSize="11"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="模型:" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
                        <TextBox x:Name="StrataModelTextBox" Grid.Column="1" FontSize="11"
                                 VerticalContentAlignment="Center" IsReadOnly="True"
                                 ToolTip="为空时自动使用包内 models\ 下最大的 .gguf"/>
                        <Button Grid.Column="2" Content="浏览..." Click="StrataModelButton_Click"
                                Margin="6,0,0,0" Padding="8,4" FontSize="11"/>
                        <Button Grid.Column="3" Content="默认" Click="StrataModelResetButton_Click"
                                Margin="4,0,0,0" Padding="8,4" FontSize="11"/>
                    </Grid>

                    <TextBox x:Name="StrataPromptTextBox" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Height="90" FontSize="11"
                             VerticalContentAlignment="Top" LostFocus="StrataPromptTextBox_LostFocus"
                             ToolTip="推理提示词"/>

                    <Grid Grid.Row="4" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Reserve:" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"
                                   ToolTip="--vram-reserve-mib：显存预留（KV/桌面）。8GB 卡建议 1500，6GB 卡可用 500-800"/>
                        <TextBox x:Name="StrataReserveBox" Grid.Column="1" FontSize="11" VerticalContentAlignment="Center" LostFocus="StrataParam_LostFocus"/>
                        <TextBlock Grid.Column="2" Text="上下文:" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0"
                                   ToolTip="--max-context"/>
                        <TextBox x:Name="StrataContextBox" Grid.Column="3" FontSize="11" VerticalContentAlignment="Center" LostFocus="StrataParam_LostFocus"/>
                        <TextBlock Grid.Column="4" Text="生成:" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0"
                                   ToolTip="--max-new：最大生成 token 数"/>
                        <TextBox x:Name="StrataMaxNewBox" Grid.Column="5" FontSize="11" VerticalContentAlignment="Center" LostFocus="StrataParam_LostFocus"/>
                        <TextBlock Grid.Column="6" Text="Prefill:" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0"
                                   ToolTip="--prefill 分块大小"/>
                        <TextBox x:Name="StrataPrefillBox" Grid.Column="7" FontSize="11" VerticalContentAlignment="Center" LostFocus="StrataParam_LostFocus"/>
                        <TextBlock Grid.Column="8" Text="KV:" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <ComboBox x:Name="StrataKvBox" Grid.Column="9" FontSize="11" SelectionChanged="StrataKvBox_SelectionChanged"
                                  ToolTip="--kv 精度。int8 数值与 fp16 逐位一致"/>
                        <TextBlock Grid.Column="10" Text="池线程:" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0"
                                   ToolTip="--pool-workers：0 = 自动。CPU 专家池线程数"/>
                        <TextBox x:Name="StrataWorkersBox" Grid.Column="11" FontSize="11" VerticalContentAlignment="Center" LostFocus="StrataParam_LostFocus"/>
                    </Grid>

                    <Grid Grid.Row="5" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="StrataStatsText" Text="" FontSize="11" FontFamily="Consolas"
                                   Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <ScrollViewer Grid.Row="1" x:Name="StrataOutputScroll" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="StrataOutputBox" IsReadOnly="True"
                                     Background="Transparent" BorderThickness="0"
                                     FontFamily="Consolas" FontSize="11"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     Foreground="{StaticResource TextPrimaryBrush}"/>
                        </ScrollViewer>
                    </Grid>

                    <Grid Grid.Row="6" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="StrataRunButton" Content="▶ 运行推理" Click="StrataRunButton_Click"
                                Margin="0,0,4,0" Padding="8,8" FontSize="13" FontWeight="SemiBold"/>
                        <Button Grid.Column="1" x:Name="StrataStopButton" Content="■ 停止" Click="StrataStopButton_Click"
                                Margin="4,0,4,0" Padding="8,8" FontSize="13" IsEnabled="False"/>
                        <Button Grid.Column="2" x:Name="StrataOpenLogButton" Content="打开日志" Click="StrataOpenLogButton_Click"
                                Padding="8,8" FontSize="13" IsEnabled="False"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Log Tab -->
            <TabItem Header="日志">
                <Grid Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="ProcessInfoText" Text="进程: 无"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <Button Grid.Column="1" Content="清空显示" Click="ClearLogButton_Click"
                                FontSize="11" Padding="10,4" Margin="0,0,6,0"/>
                        <Button Grid.Column="2" Content="打开日志文件" Click="OpenLogFileButton_Click"
                                FontSize="11" Padding="10,4"/>
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                            CornerRadius="4" Padding="6">
                        <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBox x:Name="LogTextBox" IsReadOnly="True"
                                     Background="Transparent" BorderThickness="0"
                                     FontFamily="Consolas" FontSize="11.5"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     Foreground="{StaticResource TextSecondaryBrush}"/>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Grid.Row="2" Margin="0,6,0,0" FontSize="10"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="显示 llama-manager 与 llama-server 的最近日志（自动刷新，滚动到底部）"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Action Buttons & Status -->
        <GroupBox Grid.Row="2" Header="服务控制与运行状态" Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Status Card inside Action Area -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceLightBrush}"
                        BorderBrush="{StaticResource SecondaryBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="ActionStatusDot" Grid.Column="0" Width="10" Height="10"
                                 Fill="{StaticResource ErrorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="ActionStatusText"
                                   Text="服务已停止，点击【启动服务】开始运行"
                                   FontSize="12" VerticalAlignment="Center" FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="2" x:Name="ActionEndpointText"
                                   Text="未监听" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Action Buttons -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="StartButton"
                            Content="▶ 启动服务" Click="StartButton_Click"
                            Margin="0,0,4,0" Padding="8,8" FontSize="13" FontWeight="SemiBold"/>
                    <Button Grid.Column="1" x:Name="StopButton"
                            Content="■ 停止服务" Click="StopButton_Click"
                            Margin="3,0,3,0" Padding="8,8" FontSize="13" IsEnabled="False"/>
                    <Button Grid.Column="2" x:Name="OpenButton"
                            Content="🌐 打开 Web UI" Click="OpenButton_Click"
                            Margin="3,0,3,0" Padding="8,8" FontSize="13" IsEnabled="False"/>
                    <Button Grid.Column="3" x:Name="SpeedTestButton"
                            Content="⚡ 测速" Click="SpeedTestButton_Click"
                            Margin="4,0,0,0" Padding="8,8" FontSize="13" IsEnabled="False"
                            ToolTip="实测推理速度：首Token延迟(TTFT) 与解码速度(tok/s)"/>
                </Grid>

                <!-- Options Row: Auto-open Checkbox & API Status -->
                <Grid Grid.Row="2" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" x:Name="AutoOpenBrowserCheckBox"
                              Content="启动成功后自动打开 Web UI 前端 (多模型切换调试建议保持关闭)"
                              FontSize="11" VerticalAlignment="Center"
                              Checked="AutoOpenBrowserCheckBox_Changed" Unchecked="AutoOpenBrowserCheckBox_Changed"/>
                    <TextBlock Grid.Column="1" x:Name="ApiStatusBadge"
                               Text="API: 离线" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- Autostart + Process Info -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="4"
                Padding="12,8" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="开机自启:" FontSize="11" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="1" x:Name="AutostartStatusText" Text="检测中..."
                           FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="4,0,0,0"/>
                <Button Grid.Column="2" x:Name="AutostartButton" Click="AutostartButton_Click"
                        Padding="12,4" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Embedding Service -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" CornerRadius="4"
                Padding="12,8" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="EmbeddingStatusDot" Grid.Column="0" Width="10" Height="10"
                         Fill="{StaticResource ErrorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="EmbeddingStatusText" Text="嵌入服务: 检测中..."
                           FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button Grid.Column="3" x:Name="EmbeddingToggleButton"
                        Content="启动" Click="EmbeddingToggleButton_Click"
                        Padding="12,4" FontSize="11"/>
            </Grid>
        </Border>

    </Grid>
</Window>
