<ui:FluentWindow x:Class="LlamaManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="本地大模型助手"
        Width="780" Height="720"
        MinWidth="640" MinHeight="520"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Grid TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="本地大模型助手"
                     Icon="{ui:SymbolIcon Symbol=Cube24}"
                     Height="42" ShowMinimize="True" ShowMaximize="True"
                     CanMaximize="True"/>

        <!-- Unified control bar: one engine picker and one set of lifecycle buttons for every engine. -->
        <ui:Card Grid.Row="1" x:Name="TopBarCard" Padding="14,10" Margin="14,14,14,10"
                 HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: engine picker and its maintenance actions; device badges on the right. -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="引擎:" FontSize="12" VerticalAlignment="Center"
                               Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ComboBox Grid.Column="1" x:Name="EngineBackendBox" Style="{StaticResource FluentComboBox}"
                              FontSize="12" MinWidth="180" VerticalAlignment="Center"
                              SelectionChanged="EngineBackendBox_SelectionChanged"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ui:Button x:Name="EngineRefreshButton" Content="刷新"
                                   Click="EngineRefreshButton_Click" Padding="8,3" FontSize="11"
                                   ToolTip="重新探测所有引擎并刷新设备检测"/>
                        <ui:Button x:Name="EngineDoctorButton" Content="体检"
                                   Click="EngineDoctorButton_Click" Margin="4,0,0,0" Padding="8,3" FontSize="11"
                                   ToolTip="一键体检：检查所有引擎是否缺失、是否有更新（联网查询发布版本），结果见「日志」页。"/>
                        <ui:Button x:Name="EngineTopBootstrapButton" Content="配置环境"
                                   Click="EngineTopBootstrapButton_Click" Margin="4,0,0,0" Padding="8,3" FontSize="11"
                                   ToolTip="一键配置当前引擎所需的环境（下载引擎二进制文件、自动安装 Python 3.12 及依赖 venv），结果见「日志」页。"/>
                    </StackPanel>

                    <!-- Wraps instead of clipping: the window can be as narrow as 640px. -->
                    <WrapPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="CudaText" Text="CUDA: 检测中..." FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="8,0,10,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="150"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <TextBlock x:Name="PortText" Text=":8080" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0"/>
                        <TextBlock x:Name="ActionEndpointText" Text="未监听" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="150"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <TextBlock x:Name="ApiStatusBadge" Text="API: 离线" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </WrapPanel>
                </Grid>

                <!-- Row 1: lifecycle buttons (shared by every engine) -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="0" x:Name="StartButton" Appearance="Primary" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center" Icon="{ui:SymbolIcon Symbol=Play24}"
                               Content="启动服务" Click="StartButton_Click" Margin="0,0,4,0" Padding="10,9"
                               FontSize="13" FontWeight="SemiBold"/>
                    <ui:Button Grid.Column="1" x:Name="StopButton" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center" Icon="{ui:SymbolIcon Symbol=Stop24}"
                               Content="停止服务" Click="StopButton_Click" Margin="3,0,3,0" Padding="10,9"
                               FontSize="13" IsEnabled="False"/>
                    <ui:Button Grid.Column="2" x:Name="OpenButton" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center" Icon="{ui:SymbolIcon Symbol=Globe24}"
                               Content="打开页面" Click="OpenButton_Click" Margin="3,0,3,0" Padding="10,9"
                               FontSize="13" IsEnabled="False"/>
                    <ui:Button Grid.Column="3" x:Name="SpeedTestButton" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center" Icon="{ui:SymbolIcon Symbol=Gauge24}"
                               Content="测速" Click="SpeedTestButton_Click" Margin="4,0,0,0" Padding="10,9"
                               FontSize="13" IsEnabled="False"
                               ToolTip="实测推理速度：首Token延迟(TTFT) 与解码速度(tok/s)"/>
                </Grid>

                <!-- Row 2: live state and speed. The speed keeps its own column, so a long model
                     name trims instead of pushing the rate out of the window. -->
                <Grid Grid.Row="2" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" x:Name="StatusDot" Width="12" Height="12"
                             Fill="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,8,0"
                             VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="StatusText" Text="已停止" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Grid.Column="2" x:Name="ActionStatusText" Text="选择模型后启动服务" FontSize="11"
                               Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <Border Grid.Column="3" x:Name="LiveSpeedBadge" Margin="12,0,0,0" Padding="8,3"
                            CornerRadius="6" VerticalAlignment="Center"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <TextBlock x:Name="LiveSpeedText" Text="" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </Border>
                </Grid>
            </Grid>
        </ui:Card>

        <!-- Main Tabs (left icon rail): 模型 / 参数 / 高级 / 日志 -->
        <TabControl x:Name="ConfigurationTabs" Grid.Row="2" Margin="14,0,14,14"
                    Background="Transparent" BorderThickness="0"
                    TabStripPlacement="Left"
                    Template="{DynamicResource NavTabControlTemplate}"
                    ItemContainerStyle="{DynamicResource NavTabItem}">

            <!-- ===================== 模型 ===================== -->
            <TabItem ToolTip="模型">
                <TabItem.Header>
                    <ui:SymbolIcon Symbol="Cube24" FontSize="20"/>
                </TabItem.Header>
                <Grid Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="模型目录:" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBox x:Name="ModelsDirTextBox" Grid.Column="1" FontSize="11"
                                 VerticalContentAlignment="Center" KeyDown="ModelsDirTextBox_KeyDown"
                                 LostFocus="ModelsDirTextBox_LostFocus"
                                 ToolTip="指定模型文件夹，将自动递归扫描其所有子目录下的 .gguf 文件"/>
                        <ui:Button Grid.Column="2" Content="选择文件夹..." Click="ModelsDirButton_Click"
                                Margin="6,0,0,0" Padding="8,4" FontSize="11"/>
                        <ui:Button Grid.Column="3" Content="刷新" Click="RefreshModelsButton_Click"
                                Margin="4,0,0,0" Padding="8,4" FontSize="11" ToolTip="重新扫描模型并刷新所选引擎的设备检测"/>
                        <ui:Button Grid.Column="4" Content="单文件..." Click="BrowseButton_Click"
                                Margin="4,0,0,0" Padding="8,4" FontSize="11" ToolTip="选择任意单独的 GGUF 文件"/>
                    </Grid>

                    <ListBox x:Name="ModelListBox" Grid.Row="1" ItemContainerStyle="{DynamicResource ModelListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ModelListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding FullName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding SizeFormatted}" Width="70"
                                               FontSize="11" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" CornerRadius="3" Padding="4,1" Margin="0,0,6,0"
                                            BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" BorderThickness="1"
                                            ToolTip="{Binding Category}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ModelTypeDisplay}" FontSize="10"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyModelsHint" Grid.Row="1" Visibility="Collapsed"
                               IsHitTestVisible="False" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                               FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="未找到 .gguf 模型。点击“刷新”，或用“选择文件夹…”指定模型目录。"/>

                    <Grid Grid.Row="2" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="SelectedModelText"
                                   Text="未选择模型" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" x:Name="ModelCountText"
                                   Text="共 0 个模型" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="8,0,0,0"/>
                    </Grid>

                    <TextBlock Grid.Row="3" x:Name="ModelInfoText"
                               FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,2,0,0" TextWrapping="Wrap" MaxHeight="65" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </Grid>
            </TabItem>

            <!-- ===================== 参数 ===================== -->
            <TabItem ToolTip="参数">
                <TabItem.Header>
                    <ui:SymbolIcon Symbol="Options24" FontSize="20"/>
                </TabItem.Header>
                <Grid Margin="12,8">
                    <!-- All engines: parameters generated from the backend schema (see RebuildEngineParameters) -->
                    <ui:DynamicScrollViewer x:Name="EngineParamsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock x:Name="EngineStatusText" Text="正在探测引擎…" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="EngineCompatText" Text="" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>
                            <DockPanel Margin="0,0,0,8">
                                <ui:Button x:Name="EngineResetAllButton" DockPanel.Dock="Right" Content="全部恢复默认"
                                           Click="EngineResetAllButton_Click" Margin="6,0,0,0" Padding="8,3" FontSize="11"/>
                                <ui:TextBox x:Name="EngineParamSearchBox" FontSize="11"
                                            ToolTip="按参数名或标签过滤，例如 显存 / context"
                                            TextChanged="EngineParamSearchBox_TextChanged"/>
                            </DockPanel>
                            <StackPanel x:Name="EngineParametersPanel"/>
                        </StackPanel>
                    </ui:DynamicScrollViewer>
                </Grid>
            </TabItem>

            <!-- ===================== 高级 ===================== -->
            <TabItem ToolTip="高级">
                <TabItem.Header>
                    <ui:SymbolIcon Symbol="CodeBlock24" FontSize="20"/>
                </TabItem.Header>
                <ui:DynamicScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="12,8">
                    <StackPanel Margin="0,0,10,0">
                        <!-- llama.cpp: raw args and port -->
                        <StackPanel x:Name="LlamaCppAdvancedPanel">
                            <TextBlock Text="自定义启动参数 (llama-server 命令行):" Margin="0,0,0,6" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ui:TextBox x:Name="ArgsTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" MinHeight="120" MaxHeight="260"
                                     FontFamily="Consolas" FontSize="11"
                                     VerticalContentAlignment="Top"
                                     TextChanged="ArgsTextBox_TextChanged"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Content="重新生成预设参数" Click="RegenerateButton_Click"
                                        HorizontalAlignment="Left" Padding="12,5" FontSize="11"/>
                                <TextBlock Grid.Column="1" Text="端口:" Margin="8,0,6,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <ui:TextBox x:Name="PortTextBox" Grid.Column="2" Width="60" FontSize="12"
                                         VerticalContentAlignment="Center" Text="8080" LostFocus="PortTextBox_LostFocus"/>
                            </Grid>
                            <ui:ToggleSwitch x:Name="AutoOpenBrowserCheckBox" Content="启动成功后自动打开页面 (多模型切换调试建议保持关闭)"
                                      FontSize="11" Margin="0,10,0,0" VerticalAlignment="Center"
                                      Checked="AutoOpenBrowserCheckBox_Changed" Unchecked="AutoOpenBrowserCheckBox_Changed"/>
                        </StackPanel>

                        <!-- Current engine: bootstrap (doctor is global, see the top bar) -->
                        <DockPanel Margin="0,14,0,10">
                            <ui:Button DockPanel.Dock="Left" x:Name="EngineBootstrapButton" Content="初始化环境"
                                       Click="EngineBootstrapButton_Click" Padding="12,5" FontSize="11"
                                       ToolTip="探测并安装当前引擎所需的运行时（引擎二进制、Python 依赖）。"/>
                            <TextBlock x:Name="EngineRunStatusText" Text="" FontSize="11" TextWrapping="Wrap"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </DockPanel>

                        <!-- Other engines: endpoint + output -->
                        <StackPanel x:Name="EngineAdvancedPanel" Visibility="Collapsed">
                            <TextBlock Text="接入地址（供 pi / Claude Code / Codex 使用）" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <DockPanel Margin="0,0,0,10">
                                <ui:Button DockPanel.Dock="Right" x:Name="EngineCopyUrlButton" Content="复制"
                                           Click="EngineCopyUrlButton_Click" Margin="6,0,0,0" Padding="8,3" FontSize="11"/>
                                <ui:TextBox x:Name="EngineBaseUrlTextBox" IsReadOnly="True" FontSize="11"/>
                            </DockPanel>
                            <TextBlock Text="运行输出" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,6" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Border CornerRadius="6" Padding="8" MinHeight="140" MaxHeight="320"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <ui:TextBox x:Name="EngineOutputBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                            FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" AcceptsReturn="True"
                                            VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Shared: autostart -->
                        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                Padding="0,10,0,0" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="开机自启:" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" x:Name="AutostartStatusText" Text="检测中..."
                                           FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                <ui:Button Grid.Column="2" x:Name="AutostartButton" Click="AutostartButton_Click"
                                        Padding="12,4" FontSize="11"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ui:DynamicScrollViewer>
            </TabItem>

            <!-- ===================== 嵌入 ===================== -->
            <TabItem ToolTip="嵌入服务">
                <TabItem.Header>
                    <ui:SymbolIcon Symbol="SearchInfo24" FontSize="20"/>
                </TabItem.Header>
                <StackPanel Margin="12,8" x:Name="EmbeddingPanel">
                    <TextBlock Text="嵌入（Embedding）服务" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="独立的向量化服务（如 bge-m3），供资料量化 / RAG 使用。与主模型服务相互独立，可同时运行。"/>
                    <DockPanel Margin="0,0,0,10">
                        <ui:Button DockPanel.Dock="Right" x:Name="EmbeddingToggleButton"
                                   Content="启动" Click="EmbeddingToggleButton_Click" Padding="14,6" FontSize="12"/>
                        <Grid Margin="0,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" x:Name="EmbeddingStatusDot" Width="12" Height="12"
                                     Fill="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="EmbeddingStatusText" Text="检测中..."
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="端口:" FontSize="12" Margin="12,0,6,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <ui:TextBox Grid.Column="3" x:Name="EmbeddingPortBox" Width="64" FontSize="12"
                                        VerticalContentAlignment="Center" LostFocus="EmbeddingPortBox_LostFocus"/>
                        </Grid>
                    </DockPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="嵌入模型:" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBox Grid.Column="1" x:Name="EmbeddingModelBox" FontSize="11"
                                    VerticalContentAlignment="Center" LostFocus="EmbeddingModelBox_LostFocus"
                                    ToolTip="用于向量化的 GGUF 模型（如 bge-m3-q8_0.gguf）"/>
                        <ui:Button Grid.Column="2" Content="浏览..." Click="EmbeddingModelBrowse_Click"
                                   Margin="6,0,0,0" Padding="8,4" FontSize="11"/>
                    </Grid>
                    <TextBlock x:Name="EmbeddingHintText" TextWrapping="Wrap" FontSize="10" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="提示：模型列表中选中一个模型后，也可以在这里直接将其设为嵌入模型。"/>
                </StackPanel>
            </TabItem>

            <!-- ===================== 日志 ===================== -->
            <TabItem ToolTip="日志">
                <TabItem.Header>
                    <ui:SymbolIcon Symbol="Notebook24" FontSize="20"/>
                </TabItem.Header>
                <Grid Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="ProcessInfoText" Text="进程: 无"
                                   FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <ui:Button Grid.Column="1" Content="清空显示" Click="ClearLogButton_Click"
                                FontSize="11" Padding="10,4" Margin="0,0,6,0"/>
                        <ui:Button Grid.Column="2" Content="打开日志文件" Click="OpenLogFileButton_Click"
                                FontSize="11" Padding="10,4"/>
                    </Grid>

                    <ui:Card Grid.Row="1" Padding="8" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" VerticalAlignment="Stretch">
                        <ui:DynamicScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <ui:TextBox x:Name="LogTextBox" IsReadOnly="True"
                                     Background="Transparent" BorderThickness="0"
                                     FontFamily="Consolas" FontSize="11.5"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </ui:DynamicScrollViewer>
                    </ui:Card>

                    <TextBlock Grid.Row="2" Margin="0,6,0,0" FontSize="10"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="显示 llama-manager 与所选引擎的最近日志（自动刷新，滚动到底部）"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
