<ui:FluentWindow x:Class="LlamaManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Llama.cpp Manager"
        Width="760" Height="700"
        MinWidth="620" MinHeight="480"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource PrimaryBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Llama.cpp Manager"
                     Icon="{ui:SymbolIcon Symbol=Cube24}"
                     Height="42" ShowMinimize="True" ShowMaximize="True"
                     CanMaximize="True"/>

        <Grid Grid.Row="1" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- App Bar: read-only runtime state, always visible -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="{StaticResource ErrorBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="已停止" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="ActionStatusText" Text="选择模型后启动服务" FontSize="11" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="280"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <TextBlock x:Name="LiveSpeedText" Text="" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource SuccessBrush}" Margin="14,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="CudaText" Text="CUDA: 检测中..." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,10,0" TextTrimming="CharacterEllipsis" MaxWidth="160"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <TextBlock x:Name="PortText" Text=":8080" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ActionEndpointText" Text="未监听" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ApiStatusBadge" Text="API: 离线" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tabs (left icon rail) -->
        <TabControl x:Name="ConfigurationTabs" Grid.Row="1" Margin="0,0,0,10"
                    Background="Transparent" BorderThickness="0"
                    TabStripPlacement="Left"
                    Template="{DynamicResource NavTabControlTemplate}"
                    ItemContainerStyle="{DynamicResource NavTabItem}">
            <!-- Model Selection Tab -->
            <TabItem ToolTip="模型选择">
                <TabItem.Header>
                    <ui:SymbolIcon Symbol="Cube24" FontSize="20"/>
                </TabItem.Header>
                <Grid Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Models Directory Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="模型目录:" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBox BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" x:Name="ModelsDirTextBox" Grid.Column="1" FontSize="11"
                                 VerticalContentAlignment="Center" KeyDown="ModelsDirTextBox_KeyDown"
                                 LostFocus="ModelsDirTextBox_LostFocus"
                                 ToolTip="指定模型文件夹，将自动递归扫描其所有子目录下的 .gguf 文件"/>
                        <ui:Button Grid.Column="2" Content="选择文件夹..." Click="ModelsDirButton_Click"
                                Margin="6,0,0,0" Padding="8,4" FontSize="11"/>
                        <ui:Button Grid.Column="3" Content="刷新" Click="RefreshModelsButton_Click"
                                Margin="4,0,0,0" Padding="8,4" FontSize="11" ToolTip="重新扫描模型并刷新所选引擎的设备检测"/>
                        <ui:Button Grid.Column="4" Content="单文件..." Click="BrowseButton_Click"
                                Margin="4,0,0,0" Padding="8,4" FontSize="11" ToolTip="选择任意单独的 GGUF 文件"/>
                    </Grid>

                    <ListBox x:Name="ModelListBox" Grid.Row="1" ItemContainerStyle="{DynamicResource ModelListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ModelListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding FullName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding SizeFormatted}" Width="70"
                                               FontSize="11" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" CornerRadius="3" Padding="4,1" Margin="0,0,6,0"
                                            BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1"
                                            ToolTip="{Binding Category}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ModelTypeDisplay}" FontSize="10"
                                                  />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                               FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="SelectedModelText"
                                   Text="未选择模型" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" x:Name="ModelCountText"
                                   Text="共 0 个模型" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="8,0,0,0"/>
                    </Grid>
                    
                    <TextBlock Grid.Row="3" x:Name="ModelInfoText"
                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,2,0,0" TextWrapping="Wrap" MaxHeight="65" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </Grid>
            </TabItem>

            <!-- Common Parameters Tab -->
            <TabItem ToolTip="常用参数">
                <TabItem.Header>
                    <ui:SymbolIcon Symbol="Options24" FontSize="20"/>
                </TabItem.Header>
                <Grid Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Context Length -->
                    <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="上下文长度 (-c)" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBox BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" x:Name="ContextLengthBox" Grid.Column="1" Text="8192" FontSize="12"
                                 VerticalContentAlignment="Center" TextChanged="ContextLength_TextChanged"/>
                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Symbol=QuestionCircle24}" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="context_length"/>
                    </Grid>

                    <!-- K Quantization -->
                    <Grid Grid.Row="0" Grid.Column="1" Margin="6,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="K 量化 (-ctk)" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ComboBox Style="{StaticResource FluentComboBox}" x:Name="ContextQuantKBox" Grid.Column="1" FontSize="12"
                                  SelectedIndex="0" SelectionChanged="ContextQuant_SelectionChanged">
                            <ComboBoxItem Content="默认 (未量化/f16)"/>
                            <ComboBoxItem Content="q8_0 (8-bit)"/>
                            <ComboBoxItem Content="q4_0 (4-bit)"/>
                            <ComboBoxItem Content="q4_1 (4-bit)"/>
                            <ComboBoxItem Content="f16"/>
                        </ComboBox>
                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Symbol=QuestionCircle24}" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="context_quant"/>
                    </Grid>

                    <!-- Offload Layers -->
                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="卸载层数 (-ngl)" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ComboBox Style="{StaticResource FluentComboBox}" x:Name="OffloadLayersBox" Grid.Column="1" FontSize="12"
                                  IsEditable="True" Text="all" SelectionChanged="OffloadLayers_SelectionChanged"
                                  LostFocus="OffloadLayers_LostFocus">
                            <ComboBoxItem Content="all"/>
                            <ComboBoxItem Content="auto"/>
                            <ComboBoxItem Content="0"/>
                        </ComboBox>
                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Symbol=QuestionCircle24}" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="offload_layers"/>
                    </Grid>

                    <!-- V Quantization -->
                    <Grid Grid.Row="1" Grid.Column="1" Margin="6,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="V 量化 (-ctv)" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ComboBox Style="{StaticResource FluentComboBox}" x:Name="ContextQuantVBox" Grid.Column="1" FontSize="12"
                                  SelectedIndex="0" SelectionChanged="ContextQuant_SelectionChanged">
                            <ComboBoxItem Content="默认 (未量化/f16)"/>
                            <ComboBoxItem Content="q8_0 (8-bit)"/>
                            <ComboBoxItem Content="q4_0 (4-bit)"/>
                            <ComboBoxItem Content="q4_1 (4-bit)"/>
                            <ComboBoxItem Content="f16"/>
                        </ComboBox>
                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Symbol=QuestionCircle24}" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="context_quant_v"/>
                    </Grid>

                    <!-- CPU Cores -->
                    <Grid Grid.Row="2" Grid.Column="1" Margin="6,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CPU 核心数 (-t)" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ComboBox Style="{StaticResource FluentComboBox}" x:Name="CpuCoresBox" Grid.Column="1" FontSize="12"
                                  SelectionChanged="CpuCores_SelectionChanged"/>
                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Symbol=QuestionCircle24}" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="cpu_cores"/>
                    </Grid>

                    <!-- Reasoning -->
                    <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="思考模式" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ComboBox Style="{StaticResource FluentComboBox}" x:Name="ReasoningBox" Grid.Column="1" FontSize="12"
                                  SelectedIndex="0" SelectionChanged="Reasoning_SelectionChanged">
                            <ComboBoxItem Content="默认"/>
                            <ComboBoxItem Content="off (关闭)"/>
                            <ComboBoxItem Content="on (开启)"/>
                            <ComboBoxItem Content="auto"/>
                        </ComboBox>
                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Symbol=QuestionCircle24}" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="reasoning"/>
                    </Grid>

                    <!-- Flash Attention -->
                    <Grid Grid.Row="4" Grid.Column="1" Margin="6,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Flash Attention" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ComboBox Style="{StaticResource FluentComboBox}" x:Name="FlashAttentionBox" Grid.Column="1" FontSize="12"
                                  SelectedIndex="0" SelectionChanged="FlashAttention_SelectionChanged">
                            <ComboBoxItem Content="默认"/>
                            <ComboBoxItem Content="off (关闭)"/>
                            <ComboBoxItem Content="on (开启)"/>
                            <ComboBoxItem Content="auto"/>
                        </ComboBox>
                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Symbol=QuestionCircle24}" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="flash_attention"/>
                    </Grid>

                    <!-- Batch Size -->
                    <Grid Grid.Row="3" Grid.Column="0" Margin="0,0,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="批处理大小 (-b)" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ComboBox Style="{StaticResource FluentComboBox}" x:Name="BatchSizeBox" Grid.Column="1" FontSize="12"
                                  IsEditable="True" Text="2048" SelectionChanged="BatchSize_SelectionChanged"
                                  LostFocus="BatchSize_LostFocus">
                            <ComboBoxItem Content="2048"/>
                            <ComboBoxItem Content="1024"/>
                            <ComboBoxItem Content="512"/>
                        </ComboBox>
                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Symbol=QuestionCircle24}" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click" Tag="batch_size"/>
                    </Grid>

                    <!-- UBatch Size -->
                    <Grid Grid.Row="3" Grid.Column="1" Margin="6,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="物理批大小 (-ub)" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ComboBox Style="{StaticResource FluentComboBox}" x:Name="UBatchSizeBox" Grid.Column="1" FontSize="12"
                                  IsEditable="True" Text="512" SelectionChanged="UBatchSize_SelectionChanged"
                                  LostFocus="UBatchSize_LostFocus">
                            <ComboBoxItem Content="512"/>
                            <ComboBoxItem Content="256"/>
                            <ComboBoxItem Content="128"/>
                        </ComboBox>
                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Symbol=QuestionCircle24}" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click" Tag="ubatch_size"/>
                    </Grid>

                    <!-- Verbose Logging -->
                    <Grid Grid.Row="4" Grid.Column="0" Margin="0,0,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="详细调用日志" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ComboBox Style="{StaticResource FluentComboBox}" x:Name="VerboseLogBox" Grid.Column="1" FontSize="12"
                                  SelectedIndex="0" SelectionChanged="VerboseLog_SelectionChanged">
                            <ComboBoxItem Content="关闭 (默认)"/>
                            <ComboBoxItem Content="开启 (-v / 详细)"/>
                        </ComboBox>
                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Symbol=QuestionCircle24}" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="verbose_log"/>
                    </Grid>

                    <!-- Speculative Decoding Type -->
                    <Grid Grid.Row="5" Grid.Column="0" Margin="0,0,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="投机解码" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ComboBox Style="{StaticResource FluentComboBox}" x:Name="SpecTypeBox" Grid.Column="1" FontSize="12"
                                  SelectedIndex="0" SelectionChanged="SpecType_SelectionChanged">
                            <ComboBoxItem Content="默认 (不传)"/>
                            <ComboBoxItem Content="draft-mtp"/>
                            <ComboBoxItem Content="draft-simple"/>
                            <ComboBoxItem Content="draft-eagle3"/>
                            <ComboBoxItem Content="ngram-mod"/>
                            <ComboBoxItem Content="none"/>
                        </ComboBox>
                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Symbol=QuestionCircle24}" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="spec_type"/>
                    </Grid>

                    <!-- Reasoning Budget -->
                    <Grid Grid.Row="5" Grid.Column="1" Margin="6,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="思考上限 (tokens)" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ComboBox Style="{StaticResource FluentComboBox}" x:Name="ReasoningBudgetBox" Grid.Column="1" FontSize="12"
                                  IsEditable="True" Text="默认" SelectionChanged="ReasoningBudget_SelectionChanged"
                                  LostFocus="ReasoningBudget_LostFocus">
                            <ComboBoxItem Content="默认"/>
                            <ComboBoxItem Content="-1 (无限制)"/>
                            <ComboBoxItem Content="0 (零预算)"/>
                            <ComboBoxItem Content="1024"/>
                            <ComboBoxItem Content="2048"/>
                            <ComboBoxItem Content="4096"/>
                            <ComboBoxItem Content="8192"/>
                        </ComboBox>
                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Symbol=QuestionCircle24}" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="reasoning_budget"/>
                    </Grid>

                    <!-- Speculative Draft Model -->
                    <Grid Grid.Row="6" Grid.ColumnSpan="2" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="草稿模型 (-md)" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBox BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" x:Name="DraftModelBox" Grid.Column="1" FontSize="12"
                                 VerticalContentAlignment="Center"
                                 ToolTip="投机解码草稿模型路径；与上方投机解码选项配合使用"
                                 TextChanged="DraftModel_TextChanged" LostFocus="DraftModel_LostFocus"/>
                        <ui:Button Grid.Column="2" Content="浏览..." FontSize="11"
                                Padding="8,0" Margin="6,0,0,0" Click="DraftModelBrowse_Click"/>
                        <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon Symbol=QuestionCircle24}" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="draft_model"/>
                    </Grid>

                    <!-- Built-in MTP (auto-detected from GGUF metadata) -->
                    <Border x:Name="MtpSection" Grid.Row="8" Grid.ColumnSpan="2" BorderThickness="1,0,0,0"
                            BorderBrush="{StaticResource TextSecondaryBrush}" Padding="8,6,0,4" Margin="0,4,0,0"
                            Visibility="Collapsed"
                            ToolTip="该模型的 GGUF 内置 MTP（多 Token 预测）头；开启后使用 draft-mtp 投机解码，无需单独草稿文件">
                        <ui:ToggleSwitch x:Name="MtpCheckbox" Content="启用内置 MTP 投机解码 (--spec-type draft-mtp)"
                                  FontSize="11" VerticalAlignment="Center"
                                  Checked="MtpCheckbox_Changed" Unchecked="MtpCheckbox_Changed"/>
                    </Border>

                    <!-- MoE Section (auto-hide for dense models) -->
                    <Border x:Name="MoeSection" Grid.Row="7" Grid.ColumnSpan="2" BorderThickness="1,0,0,0"
                            BorderBrush="{StaticResource TextSecondaryBrush}" Padding="8,6,0,4" Margin="0,4,0,0"
                            ToolTip="以下设置仅对MoE（混合专家）模型生效">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- MoE CPU Offload -->
                            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,6,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="MoE卸载" ToolTip="--n-cpu-moe：强制在 CPU 上计算的专家层数" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <ComboBox Style="{StaticResource FluentComboBox}" x:Name="MoeOffloadBox" Grid.Column="1" FontSize="12"
                                          IsEditable="True" Text="默认" SelectionChanged="MoeOffload_SelectionChanged"
                                          LostFocus="MoeOffload_LostFocus">
                            <ComboBoxItem Content="默认"/>
                            <ComboBoxItem Content="0 (不强制)"/>
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="8"/>
                            <ComboBoxItem Content="16"/>
                            <ComboBoxItem Content="32"/>
                        </ComboBox>
                                <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Symbol=QuestionCircle24}" FontSize="11" Width="24" Height="22"
                                        Padding="0" Margin="4,0,0,0" Click="InfoButton_Click" Tag="n_cpu_moe"/>
                            </Grid>

                            <!-- CPU MoE Toggle -->
                            <Grid Grid.Row="0" Grid.Column="1" Margin="6,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:ToggleSwitch x:Name="CpuMoeCheckbox" Grid.Column="0" Content="CPU MoE (--cpu-moe)"
                                          FontSize="11" VerticalAlignment="Center"
                                          ToolTip="强制MoE混合专家模型在CPU上计算专家层（而非GPU）"
                                          Checked="CpuMoeCheckbox_Changed" Unchecked="CpuMoeCheckbox_Changed"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Advanced Options Tab -->
            <TabItem ToolTip="高级选项">
                <TabItem.Header>
                    <ui:SymbolIcon Symbol="CodeBlock24" FontSize="20"/>
                </TabItem.Header>
                <Grid Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="自定义启动参数 (llama-server 命令行):" Margin="0,0,0,6" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                    <ui:TextBox BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" x:Name="ArgsTextBox" Grid.Row="1"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" MinHeight="100"
                             FontFamily="Consolas" FontSize="11"
                             VerticalContentAlignment="Top"
                             TextChanged="ArgsTextBox_TextChanged"/>

                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="重新生成预设参数" Click="RegenerateButton_Click"
                                HorizontalAlignment="Left" Padding="12,5" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="端口:" Margin="8,0,6,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBox BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" x:Name="PortTextBox" Grid.Column="2" Width="60" FontSize="12"
                                 VerticalContentAlignment="Center" Text="8080" LostFocus="PortTextBox_LostFocus"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Strata: preparation and parameter guidance stay scrollable on small windows. -->
            <TabItem ToolTip="Strata 推理">
                <TabItem.Header>
                    <ui:SymbolIcon Symbol="Rocket24" FontSize="20"/>
                </TabItem.Header>
                <Grid Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.4*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <ui:Button x:Name="StrataHelpButton" DockPanel.Dock="Right" Content="参数说明" Click="StrataHelpButton_Click" FontSize="11" Padding="8,3"/>
                        <TextBlock Text="Strata · 新 GGUF 先准备 Pack，再运行推理" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </DockPanel>
                    <TabControl x:Name="StrataSettingsTabs" Grid.Row="1" Margin="0,0,0,6">
                        <TabItem Header="模型与 Pack">
                            <ui:DynamicScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="6">
                                    <StackPanel x:Name="StrataSourcePanel">
                                        <TextBlock Text="包目录（含 engine 和 tools）" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <DockPanel Margin="0,3,0,6">
                                            <ui:Button DockPanel.Dock="Right" Content="浏览…" Click="StrataRootButton_Click" Margin="6,0,0,0" Padding="8,3"/>
                                            <ui:TextBox BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" x:Name="StrataRootTextBox" LostFocus="StrataParam_LostFocus" FontSize="11"/>
                                        </DockPanel>
                                        <TextBlock Text="所选 GGUF（分片模型选第一片）" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <DockPanel Margin="0,3,0,6">
                                            <ui:Button DockPanel.Dock="Right" Content="浏览…" Click="StrataModelButton_Click" Margin="6,0,0,0" Padding="8,3"/>
                                            <ui:Button DockPanel.Dock="Right" Content="默认" Click="StrataModelResetButton_Click" Margin="6,0,0,0" Padding="8,3"/>
                                            <ui:TextBox BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" x:Name="StrataModelTextBox" IsReadOnly="True" FontSize="11"/>
                                        </DockPanel>
                                        <TextBlock Text="Python 3.10+（留空自动查找；已有 Pack 推理不需要 Python）" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <DockPanel Margin="0,3,0,6">
                                            <ui:Button DockPanel.Dock="Right" Content="选择…" Tag="Python" Click="StrataPathButton_Click" Margin="6,0,0,0" Padding="8,3"/>
                                            <ui:TextBox BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" x:Name="StrataPythonTextBox" FontSize="11" LostFocus="StrataParam_LostFocus"/>
                                        </DockPanel>
                                        <TextBlock Text="Pack 缓存位置（留空使用启动器 data/strata-packs）" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <DockPanel Margin="0,3,0,6">
                                            <ui:Button DockPanel.Dock="Right" Content="选择…" Tag="Cache" Click="StrataPathButton_Click" Margin="6,0,0,0" Padding="8,3"/>
                                            <ui:TextBox BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" x:Name="StrataCacheTextBox" FontSize="11" LostFocus="StrataParam_LostFocus"/>
                                        </DockPanel>
                                    </StackPanel>
                                    <ui:Button x:Name="StrataGeneratePackButton" Content="为所选 GGUF 一键生成 / 复用 Pack" Click="StrataGeneratePackButton_Click" Padding="8,6" HorizontalAlignment="Left"/>
                                    <ProgressBar x:Name="StrataPackProgress" Height="3" Margin="0,6,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
                                    <TextBlock x:Name="StrataPackStatusText" Text="首次缺少依赖时会联网安装到独立 Python 环境；生成完成自动关联 Pack 和初始 Profile。" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,8" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Expander Header="已有 Pack / Profile / MTP 路径" FontSize="11">
                                        <StackPanel Margin="0,6,0,0">
                                            <TextBlock Text="Pack：必须对应当前 GGUF" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <DockPanel Margin="0,3,0,6">
                                                <ui:Button DockPanel.Dock="Right" Content="选择…" Tag="Pack" Click="StrataPathButton_Click" Margin="6,0,0,0"/>
                                                <ui:TextBox BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" x:Name="StrataPackTextBox" FontSize="11" LostFocus="StrataParam_LostFocus"/>
                                            </DockPanel>
                                            <TextBlock Text="Profile：专家缓存排序，初始 Profile 可直接运行" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <DockPanel Margin="0,3,0,6">
                                                <ui:Button DockPanel.Dock="Right" Content="选择…" Tag="Profile" Click="StrataPathButton_Click" Margin="6,0,0,0"/>
                                                <ui:TextBox BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" x:Name="StrataProfileTextBox" FontSize="11" LostFocus="StrataParam_LostFocus"/>
                                            </DockPanel>
                                            <TextBlock Text="MTP：可选草稿目录，需另行准备；不是另一个完整 GGUF" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <DockPanel Margin="0,3,0,6">
                                                <ui:Button DockPanel.Dock="Right" Content="选择…" Tag="Mtp" Click="StrataPathButton_Click" Margin="6,0,0,0"/>
                                                <ui:TextBox BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" x:Name="StrataMtpTextBox" FontSize="11" LostFocus="StrataParam_LostFocus"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ui:DynamicScrollViewer>
                        </TabItem>
                        <TabItem Header="运行参数">
                            <ui:DynamicScrollViewer x:Name="StrataParameterScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="6">
                                    <WrapPanel Margin="0,0,0,6">
                                        <ui:Button x:Name="StrataRecommendedButton" Content="6GB 起步" Tag="6gb" Click="StrataRecommendedButton_Click" Padding="8,4" Margin="0,0,6,4"/>
                                        <ui:Button Content="6GB / 24GB RAM" Tag="24gb" Click="StrataRecommendedButton_Click" Padding="8,4" Margin="0,0,0,4"/>
                                    </WrapPanel>
                                    <TextBlock Text="推荐值是起始配置，保留已选择的模型和 MTP 开关。推理与 llama-server 共享显存。" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="显存预留 MiB" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <ui:TextBox BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" x:Name="StrataReserveBox" Grid.Column="1" Margin="0,0,8,6" LostFocus="StrataParam_LostFocus" ToolTip="--vram-reserve-mib；6GB 从 800 起步，500 可增加专家缓存；越小越容易挤占 KV 和桌面空间。"/>
                                        <TextBlock Grid.Column="2" Text="6GB 从 800 起步；降低可增加缓存，不等于一定更快。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Grid.Row="1" Text="上下文 tokens" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <ui:TextBox BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" x:Name="StrataContextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,6" LostFocus="StrataParam_LostFocus" ToolTip="--max-context；建议 4096，包含输入和输出。增大会占用更多 KV 显存。"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="建议 4096；必须容纳提示词 + 最大生成长度。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Grid.Row="2" Text="最大生成" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <ui:TextBox BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" x:Name="StrataMaxNewBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,6" LostFocus="StrataParam_LostFocus" ToolTip="--max-new；首次 128，长回答可改 256/512。"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="首次 128；长回答可调 256/512，不能超过剩余上下文。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Grid.Row="3" Text="Prefill 分块" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <ui:TextBox BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" x:Name="StrataPrefillBox" Grid.Row="3" Grid.Column="1" Margin="0,0,8,6" LostFocus="StrataParam_LostFocus" ToolTip="--prefill；建议 2048，临时显存不足时降至 1024/512。不是上下文总长度。"/>
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="建议 2048；临时显存不足时降低，不是上下文总长度。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Grid.Row="4" Text="KV 精度" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <ComboBox Style="{StaticResource FluentComboBox}" x:Name="StrataKvBox" Grid.Row="4" Grid.Column="1" Margin="0,0,8,6" SelectionChanged="StrataKvBox_SelectionChanged" ToolTip="建议 int8；fp16 占用更多，k8v4/q4_0 更省但有不同的量化误差，不保证逐位相同。"/>
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="建议 int8；fp16 更占显存，k8v4/q4_0 更省。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Grid.Row="5" Text="CPU 池线程" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <ui:TextBox BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" x:Name="StrataWorkersBox" Grid.Row="5" Grid.Column="1" Margin="0,0,8,6" LostFocus="StrataParam_LostFocus" ToolTip="--pool-workers；0 自动；8 核 CPU 可从 6 起步，越多不一定越快。"/>
                                        <TextBlock Grid.Row="5" Grid.Column="2" Text="0 自动；8 核 CPU 可从 6 起步，线程越多不一定越快。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Grid.Row="6" Text="线程亲和" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <ComboBox Style="{StaticResource FluentComboBox}" x:Name="StrataAffinityBox" Grid.Row="6" Grid.Column="1" Margin="0,0,8,6" SelectionChanged="StrataKvBox_SelectionChanged" ToolTip="auto 自动选择，all 全部物理核心，p-cores 用于有性能核/能效核的 CPU。"/>
                                        <TextBlock Grid.Row="6" Grid.Column="2" Text="auto 通用；all 使用物理核心；p-cores 针对混合架构 CPU。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Grid.Row="7" Text="Spec 窗口" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <ui:TextBox BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" x:Name="StrataSpecBox" Grid.Row="7" Grid.Column="1" Margin="0,0,8,6" LostFocus="StrataParam_LostFocus" ToolTip="2-8；建议 2。MTP 开启时 spec 2 最多起草 1 个，spec 4 最多 3 个。无 MTP 时仍需 native 验证窗口。"/>
                                        <TextBlock Grid.Row="7" Grid.Column="2" Text="从 2 起步；MTP 可尝试 4，看吞吐而不只看接受率。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Grid.Row="8" Text="锁页 RAM GiB" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <ui:TextBox BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" x:Name="StrataArenaPinBox" Grid.Row="8" Grid.Column="1" Margin="0,0,8,6" LostFocus="StrataParam_LostFocus" ToolTip="STRATA_ARENA_PIN_GIB；主机内存，不是显存。0 自动，24GB RAM 笔记本可从 12 起步。"/>
                                        <TextBlock Grid.Row="8" Grid.Column="2" Text="0 自动；24GB RAM 可从 12 起步。这是主机内存，不是显存。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </Grid>
                                    <WrapPanel Margin="0,6,0,0">
                                        <ui:ToggleSwitch x:Name="StrataMtpCheckBox" Content="启用 MTP 草稿" Checked="StrataMtp_Changed" Unchecked="StrataMtp_Changed" Margin="0,0,16,6"/>
                                        <ui:ToggleSwitch x:Name="StrataMtpPlainCheckBox" Content="Plain RMSNorm（APEX / Qwen）" Checked="StrataMtp_Changed" Unchecked="StrataMtp_Changed" Margin="0,0,0,6"/>
                                    </WrapPanel>
                                    <TextBlock Text="MTP 需选择 runtime 目录（dense.bin / dense.txt / experts.bin）。无草稿先关闭；跨模型草稿的接受率和收益需实测。生成 Pack 不会自动生成 MTP。" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </ui:DynamicScrollViewer>
                        </TabItem>
                    </TabControl>
                    <ui:TextBox BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" x:Name="StrataPromptTextBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Height="65" FontSize="11" Margin="0,0,0,6"
                             LostFocus="StrataPromptTextBox_LostFocus" ToolTip="原始提示词；当前不自动套用聊天模板，可粘贴模型要求的完整模板。"/>
                    <Grid Grid.Row="3" Margin="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="StrataStatsText" Text="" FontSize="11" FontFamily="Consolas"
                                   Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <ui:DynamicScrollViewer Grid.Row="1" x:Name="StrataOutputScroll" VerticalScrollBarVisibility="Auto">
                            <ui:TextBox x:Name="StrataOutputBox" IsReadOnly="True"
                                     Background="Transparent" BorderThickness="0"
                                     FontFamily="Consolas" FontSize="11"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     Foreground="{StaticResource TextPrimaryBrush}"/>
                        </ui:DynamicScrollViewer>
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" x:Name="StrataRunButton" Content="▶ 运行推理" Click="StrataRunButton_Click"
                                Margin="0,0,4,0" Padding="8,8" FontSize="13" FontWeight="SemiBold"/>
                        <ui:Button Grid.Column="1" x:Name="StrataStopButton" Content="■ 停止" Click="StrataStopButton_Click"
                                Margin="4,0,4,0" Padding="8,8" FontSize="13" IsEnabled="False"/>
                        <ui:Button Grid.Column="2" x:Name="StrataOpenLogButton" Content="打开日志" Click="StrataOpenLogButton_Click"
                                Padding="8,8" FontSize="13" IsEnabled="False"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Log Tab -->
            <TabItem ToolTip="日志">
                <TabItem.Header>
                    <ui:SymbolIcon Symbol="Notebook24" FontSize="20"/>
                </TabItem.Header>
                <Grid Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="ProcessInfoText" Text="进程: 无"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <ui:Button Grid.Column="1" Content="清空显示" Click="ClearLogButton_Click"
                                FontSize="11" Padding="10,4" Margin="0,0,6,0"/>
                        <ui:Button Grid.Column="2" Content="打开日志文件" Click="OpenLogFileButton_Click"
                                FontSize="11" Padding="10,4"/>
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                            CornerRadius="4" Padding="6">
                        <ui:DynamicScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <ui:TextBox x:Name="LogTextBox" IsReadOnly="True"
                                     Background="Transparent" BorderThickness="0"
                                     FontFamily="Consolas" FontSize="11.5"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     Foreground="{StaticResource TextSecondaryBrush}"/>
                        </ui:DynamicScrollViewer>
                    </Border>

                    <TextBlock Grid.Row="2" Margin="0,6,0,0" FontSize="10"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="显示 llama-manager 与 llama-server 的最近日志（自动刷新，滚动到底部）"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Action Buttons & Status -->
        <GroupBox Grid.Row="2" Header="服务控制与运行状态" Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Status Card inside Action Area -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceLightBrush}"
                        BorderBrush="{StaticResource SecondaryBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="ActionStatusDot" Grid.Column="0" Width="10" Height="10"
                                 Fill="{StaticResource ErrorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="TabActionStatusText"
                                   Text="服务已停止，点击【启动服务】开始运行"
                                   FontSize="12" VerticalAlignment="Center" FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="2" x:Name="TabActionEndpointText"
                                   Text="未监听" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Action Buttons -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:Button Grid.Column="0" x:Name="StartButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Icon="{ui:SymbolIcon Symbol=Play24}"
                            Content="启动服务" Click="StartButton_Click"
                            Margin="0,0,4,0" Padding="10,9" FontSize="13" FontWeight="SemiBold"/>
                    <ui:Button Grid.Column="1" x:Name="StopButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Icon="{ui:SymbolIcon Symbol=Stop24}"
                            Content="停止服务" Click="StopButton_Click"
                            Margin="3,0,3,0" Padding="10,9" FontSize="13" IsEnabled="False"/>
                    <ui:Button Grid.Column="2" x:Name="OpenButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Icon="{ui:SymbolIcon Symbol=Globe24}"
                            Content="Web UI" Click="OpenButton_Click"
                            Margin="3,0,3,0" Padding="10,9" FontSize="13" IsEnabled="False"/>
                    <ui:Button Grid.Column="3" x:Name="SpeedTestButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Icon="{ui:SymbolIcon Symbol=Gauge24}"
                            Content="测速" Click="SpeedTestButton_Click"
                            Margin="4,0,0,0" Padding="10,9" FontSize="13" IsEnabled="False"
                            ToolTip="实测推理速度：首Token延迟(TTFT) 与解码速度(tok/s)"/>
                </Grid>

                <!-- Options Row: Auto-open Checkbox & API Status -->
                <Grid Grid.Row="2" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:ToggleSwitch Grid.Column="0" x:Name="AutoOpenBrowserCheckBox"
                              Content="启动成功后自动打开 Web UI 前端 (多模型切换调试建议保持关闭)"
                              FontSize="11" VerticalAlignment="Center"
                              Checked="AutoOpenBrowserCheckBox_Changed" Unchecked="AutoOpenBrowserCheckBox_Changed"/>
                    <TextBlock Grid.Column="1" x:Name="TabApiStatusBadge"
                               Text="API: 离线" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- Autostart + Process Info -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="4"
                Padding="12,8" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="开机自启:" FontSize="11" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="1" x:Name="AutostartStatusText" Text="检测中..."
                           FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="4,0,0,0"/>
                <ui:Button Grid.Column="2" x:Name="AutostartButton" Click="AutostartButton_Click"
                        Padding="12,4" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Embedding Service -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" CornerRadius="4"
                Padding="12,8" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="EmbeddingStatusDot" Grid.Column="0" Width="10" Height="10"
                         Fill="{StaticResource ErrorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="EmbeddingStatusText" Text="嵌入服务: 检测中..."
                           FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                <ui:Button Grid.Column="3" x:Name="EmbeddingToggleButton"
                        Content="启动" Click="EmbeddingToggleButton_Click"
                        Padding="12,4" FontSize="11"/>
            </Grid>
        </Border>

        </Grid>
    </Grid>
</ui:FluentWindow>
