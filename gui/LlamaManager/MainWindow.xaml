<Window x:Class="LlamaManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Llama.cpp Manager"
        Width="720" Height="820"
        MinWidth="620" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Status Bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource ErrorBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="已停止" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LiveSpeedText" Text="" FontSize="12" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="CudaText" Text="CUDA: 检测中..." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                    <TextBlock x:Name="PortText" Text=":8080" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tabs -->
        <TabControl Grid.Row="1" Margin="0,0,0,6" Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource AccentBrush}">
            <!-- Model Selection Tab -->
            <TabItem Header="模型选择">
                <Grid Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Models Directory Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="模型目录:" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
                        <TextBox x:Name="ModelsDirTextBox" Grid.Column="1" FontSize="11"
                                 VerticalContentAlignment="Center" KeyDown="ModelsDirTextBox_KeyDown"
                                 LostFocus="ModelsDirTextBox_LostFocus"
                                 ToolTip="指定模型文件夹，将自动递归扫描其所有子目录下的 .gguf 文件"/>
                        <Button Grid.Column="2" Content="选择文件夹..." Click="ModelsDirButton_Click"
                                Margin="6,0,0,0" Padding="8,4" FontSize="11"/>
                        <Button Grid.Column="3" Content="刷新" Click="RefreshModelsButton_Click"
                                Margin="4,0,0,0" Padding="8,4" FontSize="11" ToolTip="重新扫描该目录及所有子目录"/>
                        <Button Grid.Column="4" Content="单文件..." Click="BrowseButton_Click"
                                Margin="4,0,0,0" Padding="8,4" FontSize="11" ToolTip="选择任意单独的 GGUF 文件"/>
                    </Grid>

                    <ListBox x:Name="ModelListBox" Grid.Row="1"
                             Height="120" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ModelListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding FullName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding SizeFormatted}" Width="70"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" CornerRadius="3" Padding="4,1" Margin="0,0,6,0"
                                            BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1"
                                            ToolTip="{Binding Category}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ModelTypeDisplay}" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="SelectedModelText"
                                   Text="未选择模型" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" x:Name="ModelCountText"
                                   Text="共 0 个模型" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="8,0,0,0"/>
                    </Grid>
                    
                    <TextBlock Grid.Row="3" x:Name="ModelInfoText"
                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </TabItem>

            <!-- Common Parameters Tab -->
            <TabItem Header="常用参数">
                <Grid Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Context Length -->
                    <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="上下文长度 (-c)" FontSize="12" VerticalAlignment="Center"/>
                        <TextBox x:Name="ContextLengthBox" Grid.Column="1" Text="8192" FontSize="12"
                                 VerticalContentAlignment="Center" TextChanged="ContextLength_TextChanged"/>
                        <Button Grid.Column="2" Content="?" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="context_length"/>
                    </Grid>

                    <!-- Context Quantization -->
                    <Grid Grid.Row="0" Grid.Column="1" Margin="6,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="K/V 量化级别" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ContextQuantBox" Grid.Column="1" FontSize="12" Height="26"
                                  SelectedIndex="0" SelectionChanged="ContextQuant_SelectionChanged">
                            <ComboBoxItem Content="q8_0 (默认)"/>
                            <ComboBoxItem Content="q4_0"/>
                            <ComboBoxItem Content="q4_1"/>
                            <ComboBoxItem Content="f16"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="?" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="context_quant"/>
                    </Grid>

                    <!-- Offload Layers -->
                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="卸载层数 (-ngl)" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox x:Name="OffloadLayersBox" Grid.Column="1" FontSize="12" Height="26"
                                  IsEditable="True" Text="all" SelectionChanged="OffloadLayers_SelectionChanged"
                                  LostFocus="OffloadLayers_LostFocus">
                            <ComboBoxItem Content="all"/>
                            <ComboBoxItem Content="auto"/>
                            <ComboBoxItem Content="0"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="?" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="offload_layers"/>
                    </Grid>

                    <!-- CPU Cores -->
                    <Grid Grid.Row="1" Grid.Column="1" Margin="6,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CPU 核心数 (-t)" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CpuCoresBox" Grid.Column="1" FontSize="12" Height="26"
                                  SelectionChanged="CpuCores_SelectionChanged"/>
                        <Button Grid.Column="2" Content="?" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="cpu_cores"/>
                    </Grid>

                    <!-- Reasoning -->
                    <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="思考模式" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ReasoningBox" Grid.Column="1" FontSize="12" Height="26"
                                  SelectedIndex="0" SelectionChanged="Reasoning_SelectionChanged">
                            <ComboBoxItem Content="关闭 (--reasoning off)"/>
                            <ComboBoxItem Content="开启 (--reasoning on)"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="?" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="reasoning"/>
                    </Grid>

                    <!-- Flash Attention -->
                    <Grid Grid.Row="2" Grid.Column="1" Margin="6,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Flash Attention" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox x:Name="FlashAttentionBox" Grid.Column="1" FontSize="12" Height="26"
                                  SelectedIndex="0" SelectionChanged="FlashAttention_SelectionChanged">
                            <ComboBoxItem Content="关闭 (默认)"/>
                            <ComboBoxItem Content="开启 (-fa)"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="?" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="flash_attention"/>
                    </Grid>

                    <!-- Batch Size -->
                    <Grid Grid.Row="3" Grid.Column="0" Margin="0,0,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="批处理大小 (-b)" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox x:Name="BatchSizeBox" Grid.Column="1" FontSize="12" Height="26"
                                  IsEditable="True" Text="2048" SelectionChanged="BatchSize_SelectionChanged"
                                  LostFocus="BatchSize_LostFocus">
                            <ComboBoxItem Content="2048"/>
                            <ComboBoxItem Content="1024"/>
                            <ComboBoxItem Content="512"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="?" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click" Tag="batch_size"/>
                    </Grid>

                    <!-- UBatch Size -->
                    <Grid Grid.Row="3" Grid.Column="1" Margin="6,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="物理批大小 (-ub)" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox x:Name="UBatchSizeBox" Grid.Column="1" FontSize="12" Height="26"
                                  IsEditable="True" Text="512" SelectionChanged="UBatchSize_SelectionChanged"
                                  LostFocus="UBatchSize_LostFocus">
                            <ComboBoxItem Content="512"/>
                            <ComboBoxItem Content="256"/>
                            <ComboBoxItem Content="128"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="?" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click" Tag="ubatch_size"/>
                    </Grid>

                    <!-- Verbose Logging -->
                    <Grid Grid.Row="4" Grid.Column="0" Margin="0,0,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="详细调用日志" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox x:Name="VerboseLogBox" Grid.Column="1" FontSize="12" Height="26"
                                  SelectedIndex="0" SelectionChanged="VerboseLog_SelectionChanged">
                            <ComboBoxItem Content="关闭 (默认)"/>
                            <ComboBoxItem Content="开启 (-v / 详细)"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="?" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="verbose_log"/>
                    </Grid>

                    <!-- Reasoning Budget -->
                    <Grid Grid.Row="4" Grid.Column="1" Margin="6,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="思考上限 (tokens)" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ReasoningBudgetBox" Grid.Column="1" FontSize="12" Height="26"
                                  IsEditable="True" Text="无限制" SelectionChanged="ReasoningBudget_SelectionChanged"
                                  LostFocus="ReasoningBudget_LostFocus">
                            <ComboBoxItem Content="无限制"/>
                            <ComboBoxItem Content="1024"/>
                            <ComboBoxItem Content="2048 (推荐)"/>
                            <ComboBoxItem Content="4096"/>
                            <ComboBoxItem Content="8192"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="?" FontSize="11" Width="24" Height="22"
                                Padding="0" Margin="4,0,0,0" Click="InfoButton_Click"
                                Tag="reasoning_budget"/>
                    </Grid>

                    <!-- MoE Section (auto-hide for dense models) -->
                    <Border x:Name="MoeSection" Grid.Row="5" Grid.ColumnSpan="2" BorderThickness="1,0,0,0"
                            BorderBrush="{StaticResource TextSecondaryBrush}" Padding="8,6,0,4" Margin="0,4,0,0"
                            ToolTip="以下设置仅对MoE（混合专家）模型生效">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- MoE CPU Offload -->
                            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,6,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="MoE卸载 (--n-cpu-moe)" FontSize="11" VerticalAlignment="Center"/>
                                <ComboBox x:Name="MoeOffloadBox" Grid.Column="1" FontSize="12" Height="26"
                                          IsEditable="True" Text="0" SelectionChanged="MoeOffload_SelectionChanged"
                                          LostFocus="MoeOffload_LostFocus">
                                    <ComboBoxItem Content="0"/>
                                    <ComboBoxItem Content="10"/>
                                    <ComboBoxItem Content="20"/>
                                    <ComboBoxItem Content="30"/>
                                </ComboBox>
                                <Button Grid.Column="2" Content="?" FontSize="11" Width="24" Height="22"
                                        Padding="0" Margin="4,0,0,0" Click="InfoButton_Click" Tag="n_cpu_moe"/>
                            </Grid>

                            <!-- CPU MoE Toggle -->
                            <Grid Grid.Row="0" Grid.Column="1" Margin="6,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="CpuMoeCheckbox" Grid.Column="0" Content="CPU MoE (--cpu-moe)"
                                          FontSize="11" VerticalAlignment="Center"
                                          ToolTip="强制MoE混合专家模型在CPU上计算专家层（而非GPU）"
                                          Checked="CpuMoeCheckbox_Changed" Unchecked="CpuMoeCheckbox_Changed"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Advanced Options Tab -->
            <TabItem Header="高级选项">
                <Grid Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="自定义启动参数 (llama-server 命令行):" Margin="0,0,0,6" FontSize="12"/>

                    <TextBox x:Name="ArgsTextBox" Grid.Row="1"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Height="100"
                             FontFamily="Consolas" FontSize="11"
                             VerticalContentAlignment="Top"
                             TextChanged="ArgsTextBox_TextChanged"/>

                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="重新生成预设参数" Click="RegenerateButton_Click"
                                HorizontalAlignment="Left" Padding="12,5" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="端口:" Margin="8,0,6,0" FontSize="12" VerticalAlignment="Center"/>
                        <TextBox x:Name="PortTextBox" Grid.Column="2" Width="60" FontSize="12"
                                 VerticalContentAlignment="Center" Text="8080" LostFocus="PortTextBox_LostFocus"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Action Buttons -->
        <GroupBox Grid.Row="2" Header="操作" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="StartButton"
                        Content="▶ 启动并打开" Click="StartButton_Click"
                        Margin="0,0,6,0" Padding="8,10"/>
                <Button Grid.Column="1" x:Name="OpenButton"
                        Content="🌐 打开 Web UI" Click="OpenButton_Click"
                        Margin="3,0,3,0" Padding="8,10"/>
                <Button Grid.Column="2" x:Name="StopButton"
                        Content="■ 停止" Click="StopButton_Click"
                        Margin="6,0,0,0" Padding="8,10"/>
            </Grid>
        </GroupBox>

        <!-- Autostart + Process Info -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="4"
                Padding="12,8" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="开机自启:" FontSize="11" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="1" x:Name="AutostartStatusText" Text="检测中..."
                           FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="4,0,0,0"/>
                <Button Grid.Column="2" x:Name="AutostartButton" Click="AutostartButton_Click"
                        Padding="12,4" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Embedding Service -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" CornerRadius="4"
                Padding="12,8" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="EmbeddingStatusDot" Grid.Column="0" Width="10" Height="10"
                         Fill="{StaticResource ErrorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="EmbeddingStatusText" Text="嵌入服务: 检测中..."
                           FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button Grid.Column="3" x:Name="EmbeddingToggleButton"
                        Content="启动" Click="EmbeddingToggleButton_Click"
                        Padding="12,4" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Process Info + Log -->
        <GroupBox Grid.Row="5" Header="日志">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="ProcessInfoText" Text="进程: 无"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="清空显示" Click="ClearLogButton_Click" FontSize="10" Padding="6,1" Margin="0,0,4,0"/>
                        <Button Content="打开日志文件" Click="OpenLogFileButton_Click" FontSize="10" Padding="6,1"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="LogTextBox" IsReadOnly="True"
                             Background="Transparent" BorderThickness="0"
                             FontFamily="Consolas" FontSize="11"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             Foreground="{StaticResource TextSecondaryBrush}"/>
                </ScrollViewer>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
